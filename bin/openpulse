#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';
require dirname(__DIR__) . '/config/environment.php';

use OpenPulse\Core\Bootstrap;
use OpenPulse\Core\CommandResolver;

$projectRoot = dirname(__DIR__);
$currentDirectory = getcwd();

if ($currentDirectory !== $projectRoot) {
    fwrite(
        STDERR,
        "Error: Run this command from the OpenPulse project root.\n"
    );
    exit(1);
}

$commandName = $argv[1] ?? '';

try {
    $container = Bootstrap::createContainer();

    $commands = require $projectRoot . '/config/commands.php';

    $resolver = new CommandResolver($container, $commands);

    if ($commandName === '' || !in_array(
        $commandName,
        $resolver->names(),
        true
    )) {
        fwrite(
            STDERR,
            "Usage: openpulse <command>\n\n"
            . "Available commands:\n"
        );

        foreach ($resolver->names() as $name) {
            fwrite(STDERR, sprintf("  %s\n", $name));
        }

        exit(1);
    }

    $command = $resolver->resolve($commandName);

    $exitCode = $command->execute(array_slice($argv, 2));

    exit($exitCode);
} catch (Throwable $exception) {
    fwrite(
        STDERR,
        sprintf("Command failed: %s\n", $exception->getMessage())
    );
    exit(1);
}