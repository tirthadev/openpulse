{
    "name": "tirthadev/openpulse",
    "description": "Framework-free PHP and MySQL analytics platform",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Tirtharup",
            "email": "tirtharupbhattacharyya@gmail.com"
        }
    ],
   "require": {
        "php": "^8.5",
        "vlucas/phpdotenv": "^5.7",
        "predis/predis": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "OpenPulse\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3"
    },
    "scripts": {
        "tests": "phpunit tests",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@tests",
            "@analyse"
        ]
    }
}
